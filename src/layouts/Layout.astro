---
interface Props {
    title?: string;
    description?: string;
    canonicalUrl?: string;
    ogTitle?: string;
    ogDescription?: string;
    structuredData?: object[];
    isSubpage?: boolean;
}

const {
    title = "General Contractor in Payson, UT | American Legacy Contracting",
    description = "American Legacy Contracting offers licensed general contracting in Payson, Utah and throughout Utah County. Specializing in basement finishing, kitchen remodels, new construction, and handyman services. Call Alan: 801-636-9887.",
    canonicalUrl = "https://americanlegacycontracting.com/",
    ogTitle = "General Contractor in Payson, UT | American Legacy Contracting",
    ogDescription = "Licensed general contractor serving Payson, Spanish Fork, Salem, Springville, and Utah County. Basement finishing, remodels, new construction, and handyman services.",
    structuredData = [],
    isSubpage = false,
} = Astro.props;

const navPrefix = isSubpage ? '/' : '';
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <!-- Canonical -->
        <link rel="canonical" href={canonicalUrl} />
        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:image" content="https://americanlegacycontracting.com/assets/img/Logo-removebg-preview.png" />
        {structuredData.map((data) => (
            <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
        ))}
        {!isSubpage && (
        <script is:inline type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "GeneralContractor",
          "name": "American Legacy Contracting",
          "image": "https://americanlegacycontracting.com/assets/img/Logo-removebg-preview.png",
          "url": "https://americanlegacycontracting.com",
          "telephone": "801-636-9887",
          "email": "amlgcy@gmail.com",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Payson",
            "addressRegion": "UT",
            "addressCountry": "US"
          },
          "areaServed": [
            "Lehi", "American Fork", "Highland", "Alpine", "Cedar Hills",
            "Pleasant Grove", "Lindon", "Orem", "Provo", "Springville",
            "Spanish Fork", "Mapleton", "Salem", "Elk Ridge", "Payson",
            "Santaquin", "Nephi", "Utah County"
          ],
          "priceRange": "$$",
          "description": "Licensed general contractor in Payson, Utah specializing in basement finishing, kitchen remodels, new construction, and handyman services throughout Utah County.",
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Contractor Services",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Basement Finishing", "areaServed": "Utah County, UT" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen & Bathroom Remodels", "areaServed": "Utah County, UT" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "New Construction", "areaServed": "Utah County, UT" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Handyman Services", "areaServed": "Utah County, UT" } }
            ]
          }
        }
        </script>
        )}
        {!isSubpage && (
        <script is:inline type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "name": "Alan Barben",
          "jobTitle": "Owner & General Contractor",
          "worksFor": {
            "@type": "GeneralContractor",
            "name": "American Legacy Contracting",
            "url": "https://americanlegacycontracting.com"
          },
          "knowsAbout": [
            "Basement Finishing",
            "Kitchen Remodels",
            "Bathroom Remodels",
            "New Home Construction",
            "Residential Framing",
            "Construction Management"
          ],
          "hasCredential": [
            {
              "@type": "EducationalOccupationalCredential",
              "credentialCategory": "degree",
              "name": "Bachelor's Degree in Construction Management"
            },
            {
              "@type": "EducationalOccupationalCredential",
              "credentialCategory": "degree",
              "name": "Applied Science Degree in Construction Management"
            }
          ],
          "telephone": "801-636-9887",
          "email": "amlgcy@gmail.com",
          "areaServed": "Utah County, UT"
        }
        </script>
        )}
        <!-- Google Search Console verification -->
        <meta name="google-site-verification" content="2FF9tN9mZfTn18JYuiJvDJ516C-rzG-vxVyQ3xER1RI" />
        <!-- Google Analytics -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SENRBC2G16"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-SENRBC2G16');
        </script>
        <!-- Favicon-->
        <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
        <!-- Bootstrap Icons-->
        <script src="https://kit.fontawesome.com/92d991fdd5.js" crossorigin="anonymous"></script>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
        <!-- Google fonts-->
        <link href="https://fonts.googleapis.com/css2?family=Merriweather+Sans:wght@400;700&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet" />
        <!-- SimpleLightbox plugin CSS-->
        <link href="https://cdnjs.cloudflare.com/ajax/libs/SimpleLightbox/2.1.0/simpleLightbox.min.css" rel="stylesheet" />
        <!-- Core theme CSS (includes Bootstrap)-->
        <link href="/css/styles.css" rel="stylesheet" />
    </head>
    <body id="page-top">
        <!-- Navigation-->
        <nav class="navbar navbar-expand-lg navbar-light fixed-top py-3" id="mainNav">
            <div class="container px-4 px-lg-5">
                <a class="navbar-brand" href={isSubpage ? '/' : '#page-top'}><img src="/assets/img/Logo-removebg-preview.png" width="200" height="50" alt="American Legacy Contracting" /></a>
                <button class="navbar-toggler navbar-toggler-right" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarResponsive">
                    <ul class="navbar-nav ms-auto my-2 my-lg-0">
                        <li class="nav-item"><a class="nav-link" href={`${navPrefix}#about`}>About</a></li>
                        <li class="nav-item"><a class="nav-link" href="/services/">Services</a></li>
                        <li class="nav-item"><a class="nav-link" href="/service-areas/">Service Areas</a></li>
                        <li class="nav-item"><a class="nav-link" href={`${navPrefix}#portfolio`}>Projects</a></li>
                        <li class="nav-item"><a class="nav-link" href={`${navPrefix}#contact`}>Contact</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <slot />

        <!-- Footer-->
        <footer class="bg-light py-5">
            <div class="container px-4 px-lg-5">
                <div class="row gx-4 gx-lg-5 justify-content-center text-center">
                    <div class="col-lg-8">
                        <p class="small text-muted mb-1">
                            <strong>American Legacy Contracting</strong> &mdash; Licensed &amp; Insured General Contractor
                        </p>
                        <p class="small text-muted mb-1">
                            <a href="tel:8016369887" class="text-muted">801-636-9887</a>
                            &nbsp;&middot;&nbsp;
                            Serving <a href="/service-areas/" class="text-muted">17 cities</a> from Lehi to Nephi along the I-15 corridor
                        </p>
                        <p class="small text-muted mb-0">
                            Copyright &copy; <span id="current-year"></span> - American Legacy Contracting
                        </p>
                    </div>
                </div>
            </div>
        </footer>

        <script is:inline>
            const currentYear = new Date().getFullYear();
            document.getElementById("current-year").textContent = currentYear;
        </script>
        <!-- Bootstrap core JS-->
        <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <!-- SimpleLightbox plugin JS-->
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/SimpleLightbox/2.1.0/simpleLightbox.min.js"></script>
        <!-- Core theme JS-->
        <script is:inline src="/js/scripts.js"></script>
        <script is:inline src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
        <!-- CTA click tracking (once per action per session) -->
        <script is:inline>
        (function() {
            var fired = {};
            document.addEventListener('click', function(e) {
                var link = e.target.closest('a');
                if (!link) return;
                var href = link.getAttribute('href') || '';
                var text = link.textContent.trim();
                var page = window.location.pathname;
                var action = null;

                if (link.classList.contains('quote-btn') || link.id === 'quote-btn' || text.match(/Get a.*Quote/i)) {
                    action = 'get_quote';
                } else if (href.indexOf('tel:') === 0) {
                    action = 'phone_call';
                } else if (href.indexOf('sms:') === 0) {
                    action = 'text_message';
                }

                var key = action + ':' + page;
                if (action && !fired[key] && typeof gtag === 'function') {
                    fired[key] = true;
                    gtag('event', action, {
                        event_category: 'cta_click',
                        event_label: page,
                        button_text: text
                    });
                }
            });
        })();
        </script>
    </body>
</html>
