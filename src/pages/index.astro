---
import Layout from '../layouts/Layout.astro';
import site from '../content/site.json';

const serviceModules = import.meta.glob('../content/services/*.json', { eager: true });
const services = Object.values(serviceModules).sort((a: any, b: any) => a.order - b.order);

const testimonialModules = import.meta.glob('../content/testimonials/*.json', { eager: true });
const testimonials = Object.values(testimonialModules).sort((a: any, b: any) => a.order - b.order);

const portfolioModules = import.meta.glob('../content/portfolio/*.json', { eager: true });
const portfolio = Object.values(portfolioModules).sort((a: any, b: any) => a.order - b.order);

const faqItems = [
    {
        question: "Are you licensed and insured?",
        answer: "Yes. Alan Barben is fully licensed and insured in the state of Utah, and holds both a Bachelor's degree and an Applied Science degree in Construction Management."
    },
    {
        question: "What areas do you serve?",
        answer: "We serve Payson, Spanish Fork, Salem, Springville, Mapleton, Elk Ridge, and surrounding communities throughout Utah County."
    },
    {
        question: "Do you provide free estimates?",
        answer: "Yes — just call or text Alan at <a href='tel:8016369887'>801-636-9887</a> and he'll let you know if he can help, or refer you to a trusted partner who can."
    },
    {
        question: "How long does a basement finish take?",
        answer: "Most basement finishing projects take 4–8 weeks depending on scope and finishes chosen. Alan will give you a realistic timeline during the estimate."
    },
    {
        question: "Do you work with electricians and plumbers?",
        answer: "Yes. Alan works with vetted electricians and plumbers he trusts enough to use in his own home, so you have one point of contact for nearly any project."
    },
    // {
    //     question: "Can you help with both residential and commercial projects?",
    //     answer: "Yes. Alan has experience as both a residential home builder and a commercial construction manager, so he's comfortable with a wide range of project types."
    // },
    {
        question: "How do I get started?",
        answer: "Call or text Alan at <a href='tel:8016369887'>801-636-9887</a>, or fill out the contact form below. He responds quickly and will let you know next steps right away."
    }
];
---
<Layout>
    <!-- Masthead-->
    <header class="masthead">
        <div class="container px-4 px-lg-5 h-100">
            <div class="row gx-4 gx-lg-5 h-100 align-items-center justify-content-center text-center">
                <div class="col-lg-8 align-self-end">
                    <h1 class="text-white font-weight-bold">American Legacy Contracting</h1>
                    <hr class="divider" />
                </div>
                <div class="col-lg-8 align-self-baseline">
                    <p class="text-white-75 mb-5">{site.hero_tagline}</p>
                    <a class="btn btn-primary btn-xl" href="#contact">Get a Quote</a>
                </div>
            </div>
        </div>
    </header>

    <!-- About-->
    <section class="page-section bg-primary" id="about">
        <div class="container px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-8 text-center">
                    <h2 class="text-white mt-0">Get to know the owner</h2><br>
                    <div><img class="justify-content-center" src="/assets/img/portfolio/BarbenFamily.JPG" width="100%" height="100%" style="object-fit: cover; object-position: bottom;" alt="Alan Barben, owner of American Legacy Contracting, with his family" /></div>
                    <hr class="divider divider-light" />
                    <p class="text-white-75 mb-4"></p>
                    <br>
                    <p class="text-white-75 mb-4">{site.about_text}</p>
                    <a class="btn btn-light btn-xl" href="#services">Services</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Services-->
    <section class="page-section" id="services">
        <div class="container px-4 px-lg-5">
            <h2 class="text-center mt-0">Services</h2>
            <hr class="divider" />
            <div class="row gx-4 gx-lg-5">
                {services.map((s: any) => (
                    <div class="col-lg-3 col-md-6 text-center">
                        <div class="mt-5">
                            <div class="mb-2"><i class={`fa-solid ${s.icon} fa-2xl text-primary`}></i></div><br>
                            <h3 class="h4 mb-2">{s.title}</h3>
                            <p class="text-muted mb-0">{s.description}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Portfolio-->
    <div id="portfolio">
        <h2 class="text-center mt-0">Projects</h2>
        <hr class="divider" />
        <br>
        <div class="container-fluid p-0">
            <div class="row g-0">
                {portfolio.map((p: any) => (
                    <div class="col-lg-4 col-sm-6">
                        <a class="portfolio-box" href={p.lightbox_image} title={p.lightbox_title}>
                            <img class="img-fluid" src={p.image} alt={p.alt_text} loading="lazy" />
                            <div class="portfolio-box-caption">
                                <div class="project-category text-white-50">{p.category}</div>
                                <div class="project-name">{p.caption}</div>
                            </div>
                        </a>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <!-- Testimonials-->
    <section class="page-section bg-dark text-white">
        <div class="container px-4 px-lg-5 text-center">
            <h2 class="mb-4">Testimonials</h2>
            <hr class="divider" />
            <div class="row gx-4 gx-lg-5">
                {testimonials.map((t: any) => (
                    <div class="col-lg-3 col-md-6 text-center">
                        <div class="mt-5">
                            <h6 class="mb-2">"{t.quote}"</h6>
                            <p class="text-muted mb-0">- {t.author}</p>
                        </div>
                    </div>
                ))}
            </div>
            <br>
            <a class="btn btn-light btn-xl" href={site.reviews_url}>All Reviews</a>
        </div>
        <!-- Review schema -->
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "ItemList",
            "itemListElement": testimonials.map((t: any, i: number) => ({
                "@type": "ListItem",
                "position": i + 1,
                "item": {
                    "@type": "Review",
                    "reviewBody": t.quote,
                    "datePublished": t.date,
                    "author": { "@type": "Person", "name": t.author },
                    "itemReviewed": {
                        "@type": "LocalBusiness",
                        "name": "American Legacy Contracting"
                    }
                }
            }))
        })} />
    </section>

    <!-- FAQ-->
    <section class="page-section" id="faq">
        <div class="container px-4 px-lg-5">
            <h2 class="text-center mt-0">Frequently Asked Questions</h2>
            <hr class="divider" />
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-8">
                    <div class="accordion" id="faqAccordion">
                        {faqItems.map((item, i) => (
                            <div class="accordion-item">
                                <h3 class="accordion-header" id={`faq-heading-${i}`}>
                                    <button
                                        class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target={`#faq-collapse-${i}`}
                                        aria-expanded="false"
                                        aria-controls={`faq-collapse-${i}`}
                                    >
                                        {item.question}
                                    </button>
                                </h3>
                                <div
                                    id={`faq-collapse-${i}`}
                                    class="accordion-collapse collapse"
                                    aria-labelledby={`faq-heading-${i}`}
                                    data-bs-parent="#faqAccordion"
                                >
                                    <div class="accordion-body text-muted" set:html={item.answer} />
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
        <!-- FAQPage schema -->
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": faqItems.map(item => ({
                "@type": "Question",
                "name": item.question,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": item.answer
                }
            }))
        })} />
    </section>

    <!-- Scroll reveal script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var targets = document.querySelectorAll('.page-section, #portfolio .col-lg-4, #portfolio .col-sm-6');
        targets.forEach(function(el) { el.classList.add('reveal'); });
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        targets.forEach(function(el) { observer.observe(el); });
      });
    </script>

    <!-- Contact-->
    <section class="page-section" id="contact">
        <div class="container px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-8 col-xl-6 text-center">
                    <h2 class="mt-0">Get a free Quote!</h2>
                    <hr class="divider" />
                    <p class="text-muted mb-5">Ready to start your next project with us? Send us a message and we will get back to you as soon as possible!</p>
                </div>
            </div>
            <div class="row gx-4 gx-lg-5 justify-content-center mb-5">
                <iframe src={site.contact_form_url} width="640" height="824" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe>
            </div>
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-4 text-center mb-5 mb-lg-0">
                    <br>
                    <h2 class="mt-0">Contact</h2>
                    <hr class="divider" />
                    <i class="bi-phone fs-2 mb-3 text-muted"></i>
                    <div><a href={`tel:${site.phone}`}>{site.phone}</a></div><br>
                    <i class="bi-envelope fs-2 mb-3 text-muted"></i>
                    <div><a href={`mailto:${site.email}`}>{site.email}</a></div>
                    <br>
                    <p class="text-muted small mt-3">Proudly serving Payson, Spanish Fork, Salem, Springville, Mapleton, Elk Ridge, and surrounding Utah County communities.</p>
                </div>
            </div>
        </div>
    </section>
</Layout>
