---
import Layout from '../../layouts/Layout.astro';
import site from '../../content/site.json';

const areaModules = import.meta.glob('../../content/service-areas/*.json', { eager: true });
const allAreas = Object.values(areaModules).sort((a: any, b: any) => a.order - b.order);

export function getStaticPaths() {
    const modules = import.meta.glob('../../content/service-areas/*.json', { eager: true });
    const areas = Object.values(modules);
    return areas.map((area: any) => ({
        params: { slug: area.slug },
        props: { area },
    }));
}

const { area } = Astro.props;

const nearbyCities = (area.nearby_cities || [])
    .map((slug: string) => allAreas.find((a: any) => a.slug === slug))
    .filter(Boolean);

const contractorSchema = {
    "@context": "https://schema.org",
    "@type": "GeneralContractor",
    "name": "American Legacy Contracting",
    "image": "https://americanlegacycontracting.com/assets/img/Logo-removebg-preview.png",
    "url": `https://americanlegacycontracting.com/service-areas/${area.slug}/`,
    "telephone": "801-636-9887",
    "email": "amlgcy@gmail.com",
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "Payson",
        "addressRegion": "UT",
        "addressCountry": "US"
    },
    "areaServed": {
        "@type": "City",
        "name": area.city,
        "containedInPlace": { "@type": "State", "name": "Utah" }
    },
    "priceRange": "$$",
    "description": `Licensed general contractor serving ${area.city}, Utah. Basement finishing, remodels, new construction, and handyman services.`,
    "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Contractor Services",
        "itemListElement": (area.local_services || []).map((s: any) => ({
            "@type": "Offer",
            "itemOffered": {
                "@type": "Service",
                "name": s.title,
                "areaServed": `${area.city}, UT`
            }
        }))
    }
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://americanlegacycontracting.com/" },
        { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://americanlegacycontracting.com/service-areas/" },
        { "@type": "ListItem", "position": 3, "name": area.city, "item": `https://americanlegacycontracting.com/service-areas/${area.slug}/` }
    ]
};

const smsLink = "sms:8016369887?body=Hey%20Alan%2C%20I%27m%20looking%20to%20get%20some%20work%20done%20and%20would%20love%20to%20have%20you%20come%20over%20and%20give%20me%20a%20quote!";
---
<Layout
    title={area.meta_title}
    description={area.meta_description}
    canonicalUrl={`https://americanlegacycontracting.com/service-areas/${area.slug}/`}
    ogTitle={area.meta_title}
    ogDescription={area.meta_description}
    structuredData={[contractorSchema, breadcrumbSchema]}
    isSubpage={true}
>
    <!-- Breadcrumb -->
    <div class="bg-light border-bottom" style="padding-top: 5rem;">
        <div class="container px-4 px-lg-5">
            <nav aria-label="breadcrumb" class="py-2">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/service-areas/">Service Areas</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{area.city}</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Hero -->
    <header class="page-section bg-dark text-white">
        <div class="container px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 justify-content-center text-center">
                <div class="col-lg-8">
                    <h1 class="mt-0">{area.hero_heading}</h1>
                    <hr class="divider divider-light" />
                    <p class="text-white-75 mb-4">{area.hero_subheading}</p>
                    <a class="btn btn-primary btn-xl quote-btn" href="/#contact">Get a Free Quote</a>
                    <script is:inline>
                      document.querySelectorAll('.quote-btn').forEach(function(btn) {
                        btn.addEventListener('click', function(e) {
                          if (/Mobi|Android/i.test(navigator.userAgent)) {
                            e.preventDefault();
                            window.location.href = 'sms:8016369887?body=Hey%20Alan%2C%20I%27m%20looking%20to%20get%20some%20work%20done%20and%20would%20love%20to%20have%20you%20come%20over%20and%20give%20me%20a%20quote!';
                          }
                        });
                      });
                    </script>
                </div>
            </div>
        </div>
    </header>

    <!-- About This City -->
    <section class="page-section bg-primary">
        <div class="container px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-8 text-center">
                    <h2 class="text-white mt-0">Serving {area.city}, Utah</h2>
                    <hr class="divider divider-light" />
                    <p class="text-white-75 mb-4">{area.about_city}</p>
                    {area.additional_content && (
                        <p class="text-white-75 mb-4">{area.additional_content}</p>
                    )}
                </div>
            </div>
        </div>
    </section>

    <!-- Services -->
    <section class="page-section">
        <div class="container px-4 px-lg-5">
            <h2 class="text-center mt-0">Our Services in {area.city}</h2>
            <hr class="divider" />
            <div class="row gx-4 gx-lg-5">
                {(area.local_services || []).map((s: any) => (
                    <div class="col-lg-3 col-md-6 text-center">
                        <div class="mt-5">
                            <div class="mb-2"><i class={`fa-solid ${s.icon} fa-2xl text-primary`}></i></div><br>
                            <h3 class="h4 mb-2">{s.title}</h3>
                            <p class="text-muted mb-0">{s.description}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="page-section bg-light">
        <div class="container px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-8 text-center">
                    <h2 class="mt-0">Why Choose American Legacy Contracting?</h2>
                    <hr class="divider" />
                </div>
            </div>
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-3 col-md-6 text-center mt-4">
                    <div class="mb-2"><i class="fa-solid fa-certificate fa-2xl text-primary"></i></div><br>
                    <h4 class="h5">Licensed & Insured</h4>
                    <p class="text-muted small">Fully licensed and insured in the state of Utah for your protection and peace of mind.</p>
                </div>
                <div class="col-lg-3 col-md-6 text-center mt-4">
                    <div class="mb-2"><i class="fa-solid fa-graduation-cap fa-2xl text-primary"></i></div><br>
                    <h4 class="h5">Degree in Construction</h4>
                    <p class="text-muted small">Alan holds both a Bachelor's and Applied Science degree in Construction Management.</p>
                </div>
                <div class="col-lg-3 col-md-6 text-center mt-4">
                    <div class="mb-2"><i class="fa-solid fa-clock fa-2xl text-primary"></i></div><br>
                    <h4 class="h5">14+ Years Experience</h4>
                    <p class="text-muted small">Over a decade of hands-on experience in residential construction and remodeling.</p>
                </div>
                <div class="col-lg-3 col-md-6 text-center mt-4">
                    <div class="mb-2"><i class="fa-solid fa-handshake fa-2xl text-primary"></i></div><br>
                    <h4 class="h5">Owner-Operated</h4>
                    <p class="text-muted small">Alan is on every job — you work directly with the owner, not a project manager.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Nearby Service Areas -->
    {nearbyCities.length > 0 && (
    <section class="page-section">
        <div class="container px-4 px-lg-5">
            <h2 class="text-center mt-0">Nearby Service Areas</h2>
            <hr class="divider" />
            <div class="row gx-4 gx-lg-5 justify-content-center">
                {nearbyCities.map((nearby: any) => (
                    <div class="col-lg-3 col-md-4 col-6 mb-4">
                        <a href={`/service-areas/${nearby.slug}/`} class="text-decoration-none">
                            <div class="card h-100 shadow-sm border-0 service-area-card text-center p-3">
                                <i class="fa-solid fa-location-dot fa-lg text-primary mb-2"></i>
                                <h4 class="h6 text-dark mb-0">{nearby.city}, UT</h4>
                            </div>
                        </a>
                    </div>
                ))}
                <div class="col-lg-3 col-md-4 col-6 mb-4">
                    <a href="/service-areas/" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 service-area-card text-center p-3">
                            <i class="fa-solid fa-map fa-lg text-primary mb-2"></i>
                            <h4 class="h6 text-dark mb-0">All Service Areas</h4>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>
    )}

    <!-- CTA -->
    <section class="page-section bg-dark text-white">
        <div class="container px-4 px-lg-5 text-center">
            <h2 class="mt-0">Ready to Start Your Project in {area.city}?</h2>
            <hr class="divider divider-light" />
            <p class="text-white-75 mb-4">Call or text Alan directly for a free estimate. He responds quickly and will let you know next steps right away.</p>
            <a class="btn btn-primary btn-xl" href="tel:8016369887">Call 801-636-9887</a>
            <a class="btn btn-outline-light btn-xl ms-2" href={smsLink}>Text Alan</a>
        </div>
    </section>

    <style>
        .service-area-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .service-area-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
        }
    </style>
</Layout>
