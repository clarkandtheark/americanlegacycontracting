---
import Layout from '../../layouts/Layout.astro';
import site from '../../content/site.json';

const faqItems = [
    {
        question: "How much does a handyman charge per hour in Utah?",
        answer: "Rates vary depending on the type of project and the materials involved. Rather than quoting hourly rates, Alan prefers to give you a clear, upfront price for the entire job so there are no surprises. <a href='tel:8016369887'>Call or text</a> for a free estimate on your specific project."
    },
    {
        question: "Do you handle electrical and plumbing?",
        answer: "Alan works with trusted, licensed electricians and plumbers he knows well enough to use in his own home. You get one point of contact — Alan — and he coordinates any specialized trades so you don't have to hire multiple contractors."
    },
    {
        question: "Is there a minimum job size?",
        answer: "No job is too small. Whether you need a single door hung, a section of drywall patched, or a fence post replaced, Alan is happy to help. Many of our best customer relationships started with a small repair."
    },
    {
        question: "How quickly can you start?",
        answer: "Alan can typically start within a week, and often sooner for smaller jobs. <a href='tel:8016369887'>Call or text</a> to discuss your timeline and he'll let you know his current availability."
    }
];

const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://americanlegacycontracting.com/" },
            { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://americanlegacycontracting.com/services/" },
            { "@type": "ListItem", "position": 3, "name": "Handyman Services", "item": "https://americanlegacycontracting.com/services/handyman-services/" }
        ]
    },
    {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Handyman Services",
        "name": "Handyman Services in Utah County",
        "description": "Professional handyman services in Utah County. Drywall repair, door installation, fencing, decks, painting, tile, flooring, trim, and general home repairs. Licensed and insured.",
        "provider": {
            "@type": "GeneralContractor",
            "name": "American Legacy Contracting",
            "telephone": "801-636-9887",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Payson",
                "addressRegion": "UT",
                "addressCountry": "US"
            }
        },
        "areaServed": {
            "@type": "State",
            "name": "Utah"
        }
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
            "@type": "Question",
            "name": item.question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": item.answer
            }
        }))
    }
];
---
<Layout
    title="Handyman Services in Utah County | American Legacy Contracting"
    description="Reliable handyman services in Utah County. Drywall repair, door installation, fencing, decks, painting, tile, flooring, and general home repairs. Licensed, insured, owner-operated. Call 801-636-9887."
    canonicalUrl="https://americanlegacycontracting.com/services/handyman-services/"
    ogTitle="Handyman Services in Utah County | American Legacy Contracting"
    ogDescription="No job too small. Drywall, doors, fences, decks, painting, tile, and home repairs by a licensed Utah contractor. Call 801-636-9887 for a free estimate."
    structuredData={structuredData}
    isSubpage={true}
>
    <!-- Hero -->
    <header class="masthead-sm bg-primary">
        <div class="container px-4 px-lg-5 py-5">
            <div class="row justify-content-center text-center" style="padding-top: 5rem;">
                <div class="col-lg-8">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-center mb-3" style="--bs-breadcrumb-divider-color: rgba(255,255,255,.6); --bs-breadcrumb-item-active-color: #fff;">
                            <li class="breadcrumb-item"><a href="/" class="text-white-75">Home</a></li>
                            <li class="breadcrumb-item"><a href="/services/" class="text-white-75">Services</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">Handyman Services</li>
                        </ol>
                    </nav>
                    <h1 class="text-white font-weight-bold mt-0">Handyman Services in Utah County</h1>
                    <hr class="divider divider-light" />
                    <p class="text-white-75 mb-4">Not every home project requires a full renovation — sometimes you just need a skilled set of hands to knock out your to-do list. From drywall patches and door installations to fence repairs and painting, American Legacy Contracting handles the small-to-medium jobs that keep your home in top shape. And because Alan is a licensed general contractor, you're getting a higher level of quality and accountability than a typical handyman.</p>
                    <a class="btn btn-light btn-xl quote-btn" href="/#contact">Get a Quote</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Services We Offer -->
    <section class="page-section">
        <div class="container px-4 px-lg-5">
            <h2 class="text-center mt-0">Services We Offer</h2>
            <hr class="divider" />
            <p class="text-muted text-center mb-5">Here's a sample of the handyman services we provide. Don't see what you need? <a href="tel:8016369887">Call Alan</a> — if he can't help, he'll refer you to someone who can.</p>
            <div class="row gx-4 gx-lg-5">
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-brush fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Drywall Repair & Installation</h3>
                        <p class="text-muted mb-0">Patches, hole repairs, water damage repair, new drywall hanging, taping, and texturing.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-door-open fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Door Installation & Repair</h3>
                        <p class="text-muted mb-0">Interior and exterior door installation, hardware replacement, weather stripping, and alignment fixes.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-bars fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Fence Repair & Installation</h3>
                        <p class="text-muted mb-0">Wood and vinyl fence repair, post replacement, gate fixes, and new fence installation.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-tree fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Deck Repair & Maintenance</h3>
                        <p class="text-muted mb-0">Board replacement, railing repair, staining, sealing, and structural fixes to extend your deck's life.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-border-all fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Tile Repair</h3>
                        <p class="text-muted mb-0">Cracked tile replacement, re-grouting, and repair work in kitchens, bathrooms, and entryways.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-box fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Shelving & Storage</h3>
                        <p class="text-muted mb-0">Custom shelving, closet organization systems, garage storage, and built-in storage solutions.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-paint-roller fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Painting & Touch-Ups</h3>
                        <p class="text-muted mb-0">Interior painting, touch-ups, accent walls, and trim painting to refresh the look of any room.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-wrench fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">General Home Repairs</h3>
                        <p class="text-muted mb-0">Squeaky floors, sticky windows, loose railings, and all the little fixes that add up. Alan handles it.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-layer-group fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Flooring</h3>
                        <p class="text-muted mb-0">Hardwood, laminate, LVP, and tile flooring installation and repair for any room in your home.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 text-center mb-4">
                    <div class="mt-3">
                        <div class="mb-2"><i class="fa-solid fa-ruler-combined fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Trim & Molding</h3>
                        <p class="text-muted mb-0">Baseboard, crown molding, door casing, and window trim installation and replacement.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Trusted Network -->
    <section class="page-section bg-light">
        <div class="container px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-8 text-center">
                    <h2 class="mt-0">A Trusted Network of Professionals</h2>
                    <hr class="divider" />
                    <p class="text-muted mb-3">Need something beyond what a general handyman can do? Alan works with vetted, licensed electricians and plumbers he trusts enough to use in his own home. That means you have one reliable point of contact for nearly any home repair or improvement — even the jobs that require specialized trades.</p>
                    <p class="text-muted mb-4">Instead of hunting for an electrician you can trust or a plumber who'll show up on time, just call Alan. He'll coordinate everything and make sure the work meets his standards — the same standards he holds for work done on his own house.</p>
                    <div class="row gx-4 gx-lg-5 mt-4">
                        <div class="col-md-4 text-center mb-3">
                            <i class="fa-solid fa-bolt fa-2xl text-primary mb-3"></i><br><br>
                            <h3 class="h6">Licensed Electricians</h3>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <i class="fa-solid fa-faucet-drip fa-2xl text-primary mb-3"></i><br><br>
                            <h3 class="h6">Licensed Plumbers</h3>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <i class="fa-solid fa-phone fa-2xl text-primary mb-3"></i><br><br>
                            <h3 class="h6">One Point of Contact</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Mid-page CTA -->
    <section class="page-section bg-primary">
        <div class="container px-4 px-lg-5 text-center">
            <h2 class="text-white mt-0">Got a To-Do List?</h2>
            <hr class="divider divider-light" />
            <p class="text-white-75 mb-4">Stop putting off those home repairs. Call or text Alan for a free estimate — he'll let you know what it takes and when he can get started.</p>
            <a class="btn btn-light btn-xl quote-btn" href="/#contact">Get a Quote</a>
            <a class="btn btn-outline-light btn-xl ms-2" href="tel:8016369887">Call 801-636-9887</a>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="page-section">
        <div class="container px-4 px-lg-5">
            <h2 class="text-center mt-0">Why Choose a Licensed Contractor for Handyman Work?</h2>
            <hr class="divider" />
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-8 text-center mb-4">
                    <p class="text-muted">Unlike unlicensed handymen, Alan is a fully licensed and insured general contractor. That means better quality work, proper insurance coverage, and the peace of mind that comes from working with someone who has formal training and years of professional experience.</p>
                </div>
            </div>
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-3 col-md-6 text-center mb-4">
                    <div class="mt-4">
                        <div class="mb-2"><i class="fa-solid fa-certificate fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Licensed & Insured</h3>
                        <p class="text-muted mb-0">Fully licensed and insured in the state of Utah — your home is protected.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 text-center mb-4">
                    <div class="mt-4">
                        <div class="mb-2"><i class="fa-solid fa-graduation-cap fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">CM Degree</h3>
                        <p class="text-muted mb-0">Bachelor's and Applied Science degrees in Construction Management.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 text-center mb-4">
                    <div class="mt-4">
                        <div class="mb-2"><i class="fa-solid fa-calendar-check fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">14+ Years Experience</h3>
                        <p class="text-muted mb-0">Over 14 years of residential and commercial construction experience.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 text-center mb-4">
                    <div class="mt-4">
                        <div class="mb-2"><i class="fa-solid fa-user-check fa-2xl text-primary"></i></div><br>
                        <h3 class="h5 mb-2">Owner-Operated</h3>
                        <p class="text-muted mb-0">Alan does the work himself — no random subcontractors showing up at your door.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="page-section bg-light">
        <div class="container px-4 px-lg-5">
            <h2 class="text-center mt-0">Handyman Services FAQ</h2>
            <hr class="divider" />
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-lg-8">
                    <div class="accordion" id="faqAccordion">
                        {faqItems.map((item, i) => (
                            <div class="accordion-item">
                                <h3 class="accordion-header" id={`faq-heading-${i}`}>
                                    <button
                                        class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target={`#faq-collapse-${i}`}
                                        aria-expanded="false"
                                        aria-controls={`faq-collapse-${i}`}
                                    >
                                        {item.question}
                                    </button>
                                </h3>
                                <div
                                    id={`faq-collapse-${i}`}
                                    class="accordion-collapse collapse"
                                    aria-labelledby={`faq-heading-${i}`}
                                    data-bs-parent="#faqAccordion"
                                >
                                    <div class="accordion-body text-muted" set:html={item.answer} />
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Service Areas -->
    <section class="page-section">
        <div class="container px-4 px-lg-5 text-center">
            <h2 class="mt-0">Handyman Services Across Utah County</h2>
            <hr class="divider" />
            <p class="text-muted mb-4">We provide handyman services in Payson, Spanish Fork, Salem, Springville, Provo, Orem, Lehi, American Fork, and communities throughout Utah County. No matter where you are along the I-15 corridor, Alan is ready to tackle your home repair needs.</p>
            <a class="btn btn-outline-primary btn-lg" href="/service-areas/">View All Service Areas</a>
        </div>
    </section>

    <!-- Bottom CTA -->
    <section class="page-section bg-dark text-white">
        <div class="container px-4 px-lg-5 text-center">
            <h2 class="mt-0">Ready to Cross Items Off Your List?</h2>
            <hr class="divider divider-light" />
            <p class="text-white-75 mb-4">From a quick drywall patch to a full fence replacement, Alan handles home repairs and improvements with the skill and care of a licensed contractor. Call or text for a free estimate.</p>
            <a class="btn btn-primary btn-xl quote-btn" href="/#contact">Get a Quote</a>
            <br class="d-block d-md-none"><br class="d-block d-md-none">
            <a class="btn btn-light btn-xl mt-3 mt-md-0 ms-md-2" href="tel:8016369887">Call 801-636-9887</a>
            <a class="btn btn-outline-light btn-xl mt-3 mt-md-0 ms-md-2" href="sms:8016369887?body=Hey%20Alan%2C%20I%20have%20a%20handyman%20project%20I%20need%20help%20with%20and%20would%20love%20to%20have%20you%20come%20take%20a%20look!">Text Alan</a>
        </div>
    </section>

    <script is:inline>
      document.querySelectorAll('.quote-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          if (/Mobi|Android/i.test(navigator.userAgent)) {
            e.preventDefault();
            window.location.href = 'sms:8016369887?body=Hey%20Alan%2C%20I%20have%20a%20handyman%20project%20I%20need%20help%20with%20and%20would%20love%20to%20have%20you%20come%20take%20a%20look!';
          }
        });
      });
    </script>

    <style>
        .masthead-sm {
            padding-top: 2rem;
            padding-bottom: 2rem;
        }
    </style>
</Layout>
